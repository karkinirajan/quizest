# Set as real environment variables (the app does not load .env itself). Never commit secrets.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
# Google sign-in (the button is only usable when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
